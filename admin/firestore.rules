rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Licenses collection — stores license keys AND trial device records.
    // License key docs: "CNPO-K7ZM-2XN4-PQ9R"
    // Trial device docs: "trial:{deviceId}" with _type='trial_device'
    // IMPORTANT: In production, add authentication!
    match /licenses/{docId} {
      allow read, write: if true; // TODO: Add auth check before going public
    }
  }
}
